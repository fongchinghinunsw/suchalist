{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    // absolute imports (path aliases)
    "paths": {
      "@/*": ["src/*"],
      "@/components/*": ["src/components/*"],
      "@/hooks/*": ["src/hooks/*"],
      "@/stores/*": ["src/stores/*"],
      "@/constants/*": ["src/constants/*"]
    },
    // platform-specific extensions
    "moduleSuffixes": [".ios", ".android", ".native", ""]
  }
}
